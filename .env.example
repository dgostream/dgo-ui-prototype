# ─── Sanity (required for CMS content on Vercel) ─────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Optional override (default: 2024-02-05)
# NEXT_PUBLIC_SANITY_API_VERSION=2024-02-05
# Server-only: for admin writes / migrations (optional in read-only deploys)
# SANITY_API_WRITE_TOKEN=

# ─── Admin API (optional) ───────────────────────────────────────────────────
# ADMIN_PASSWORD=

# ─── Translation API (optional) ─────────────────────────────────────────────
# GOOGLE_TRANSLATE_API_KEY=
